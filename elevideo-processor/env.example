# ─────────────────────────────────────────────
# Cloudinary
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Directorio local para archivos temporales de procesamiento
CLOUDINARY_TEMP_DIR=/tmp/video_processing

# ─────────────────────────────────────────────
# Autenticación
# ─────────────────────────────────────────────
# Secret HS256 compartido con Spring Boot (jwt.secret en Spring)
SERVICE_JWT_SECRET=change_me_in_production

# API key interna para comunicación entre servicios
SERVICE_API_KEY=change_me_in_production

# ─────────────────────────────────────────────
# Webhooks hacia Spring Boot
# ─────────────────────────────────────────────
# Notificaciones finales (completado / fallido / cancelado)
SPRING_BOOT_WEBHOOK_URL=https://your-api.com/api/internal/webhooks/job-completed

# Notificaciones de progreso en tiempo real (best-effort)
SPRING_BOOT_PROGRESS_WEBHOOK_URL=https://your-api.com/api/internal/webhooks/job-progress

# ─────────────────────────────────────────────
# Protecciones del demo
# ─────────────────────────────────────────────
# Un solo FFmpeg pesado a la vez por defecto. Sube este valor solo si la máquina lo soporta.
PROCESSING_MAX_CONCURRENT_JOBS=1

# Jobs esperando globalmente. Con 1 worker, el sistema admite hasta 1 procesando + 8 en cola.
PROCESSING_MAX_QUEUE_SIZE=8

# Un usuario puede ocupar como máximo 3 slots entre cola y procesamiento.
PROCESSING_MAX_OUTSTANDING_PER_USER=3

# Límites anti-ráfaga. Evitan spam inmediato, pero no existe cuota horaria ni diaria.
PROCESSING_MAX_REQUESTS_PER_MINUTE=6
PROCESSING_MAX_GLOBAL_REQUESTS_PER_MINUTE=20

# Los jobs terminados se conservan en memoria durante este tiempo.
PROCESSING_JOB_RETENTION_HOURS=24

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Activar reload automático (solo desarrollo)
RELOAD=true

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
